import NSDensity.ConcreteDescent
import Mathlib.LinearAlgebra.Isomorphisms
import Mathlib.LinearAlgebra.Span.Basic

open scoped BigOperators

namespace NSDensity

/-- Column evaluation over any specified coefficient field. This version
also applies to the field generated by the root inside a larger ambient
field. -/
def columnEvalOver {F E I : Type*} [Field F] [Field E] [Algebra F E] [Fintype I]
    (v : I → E) : (I → F) →ₗ[F] E where
  toFun c := ∑ i, c i • v i
  map_add' _ _ := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' s c := by simp [smul_smul, Finset.smul_sum]

def permuteCoeffsOver (F : Type*) [Field F] {I : Type*} (σ : Equiv.Perm I) :
    (I → F) →ₗ[F] (I → F) where
  toFun c := c ∘ σ
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem columnEvalOver_permute {F E I : Type*} [Field F] [Field E] [Algebra F E]
    [Fintype I] (v : I → E) (σ : Equiv.Perm I) (c : I → F) :
    columnEvalOver v (c ∘ σ) = ∑ i, c i • v (σ.symm i) := by
  simpa [columnEvalOver, Function.comp_def] using
    Equiv.sum_comp σ (fun i : I => c i • v (σ.symm i))

/-- Equality of coefficient relation kernels is exactly what is required
to obtain a linear equivalence on the spanned column space. -/
theorem exists_column_linearEquiv_over {F E I : Type*} [Field F] [Field E]
    [Algebra F E] [Finite E] [Fintype I] (v : I → E)
    (hspan : Function.Surjective (columnEvalOver (F := F) v)) (σ : Equiv.Perm I)
    (hσ : ∀ c : I → F, columnEvalOver v c = 0 ↔ columnEvalOver v (c ∘ σ) = 0) :
    ∃ T : E ≃ₗ[F] E, ∀ i : I, T (v i) = v (σ.symm i) := by
  classical
  let f := columnEvalOver (F := F) v
  let g := f.comp (permuteCoeffsOver F σ)
  have hker : LinearMap.ker f ≤ LinearMap.ker g := fun c hc => (hσ c).1 hc
  let T : E →ₗ[F] E := f.liftOfSurjective hspan ⟨g, hker⟩
  have hT (c : I → F) : T (f c) = f (c ∘ σ) :=
    LinearMap.equivOfSurjective_apply _ _
  have hinj : Function.Injective T := by
    apply (LinearMap.ker_eq_bot).1
    apply eq_bot_iff.mpr
    intro x hx
    obtain ⟨c, rfl⟩ := hspan x
    change f c = 0
    apply (hσ c).2
    change T (f c) = 0 at hx
    rw [← hT]
    exact hx
  refine ⟨LinearEquiv.ofBijective T ⟨hinj, Finite.surjective_of_injective hinj⟩, fun i => ?_⟩
  have hsingle : f (Pi.single i 1) = v i := by
    change (∑ j, (Pi.single i (1 : F) : I → F) j • v j) = v i
    rw [Finset.sum_eq_single i]
    · simp
    · intro j _ hj; simp [hj]
    · simp
  have hpermsingle : f (Pi.single i 1 ∘ σ) = v (σ.symm i) := by
    change columnEvalOver v (Pi.single i 1 ∘ σ) = _
    rw [columnEvalOver_permute, Finset.sum_eq_single i]
    · simp
    · intro j _ hj; simp [hj]
    · simp
  change T (v i) = v (σ.symm i)
  simpa only [hsingle, hpermsingle] using hT (Pi.single i 1)

end NSDensity

namespace NSDensity.Concrete

variable {E : Type*} [Field E] {I : Type*} [Fintype I]

/-- Evaluation of the coefficient vector at the columns of a generator
matrix. Its kernel is exactly `relationCode`. -/
def columnEval (F : Subfield E) (v : I → E) : (I → F) →ₗ[F] E where
  toFun c := ∑ i, (c i : E) * v i
  map_add' c d := by simp [add_mul, Finset.sum_add_distrib]
  map_smul' s c := by
    simp only [RingHom.id_apply, Pi.smul_apply, smul_eq_mul, Subfield.coe_mul,
      Algebra.smul_def, Finset.mul_sum, mul_assoc]
    rfl

@[simp]
theorem columnEval_apply (F : Subfield E) (v : I → E) (c : I → F) :
    columnEval F v c = ∑ i, (c i : E) * v i := rfl

@[simp]
theorem columnEval_ker (F : Subfield E) (v : I → E) :
    LinearMap.ker (columnEval F v) = relationCode F v := by ext; rfl

/-- Reindexing coefficients by a coordinate permutation is a linear map. -/
def permuteCoeffs (F : Subfield E) (σ : Equiv.Perm I) : (I → F) →ₗ[F] (I → F) where
  toFun c := c ∘ σ
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

omit [Fintype I] in
@[simp]
theorem permuteCoeffs_apply (F : Subfield E) (σ : Equiv.Perm I) (c : I → F) :
    permuteCoeffs F σ c = c ∘ σ := rfl

theorem columnEval_permute (F : Subfield E) (v : I → E) (σ : Equiv.Perm I)
    (c : I → F) :
    columnEval F v (c ∘ σ) = ∑ i, (c i : E) * v (σ.symm i) := by
  simpa [columnEval, Function.comp_def] using
    Equiv.sum_comp σ (fun i : I => (c i : E) * v (σ.symm i))

@[simp]
theorem columnEval_single [DecidableEq I] (F : Subfield E) (v : I → E) (i : I) :
    columnEval F v (Pi.single i 1) = v i := by
  rw [columnEval_apply, Finset.sum_eq_single i]
  · simp
  · intro j _ hj
    simp [hj]
  · simp

@[simp]
theorem columnEval_permute_single [DecidableEq I] (F : Subfield E) (v : I → E)
    (σ : Equiv.Perm I) (i : I) :
    columnEval F v (Pi.single i 1 ∘ σ) = v (σ.symm i) := by
  rw [columnEval_permute, Finset.sum_eq_single i]
  · simp
  · intro j _ hj
    simp [hj]
  · simp

/-- Preservation of the relation kernel produces an actual invertible
linear transformation of the ambient column space, assuming the columns
span that space. The direction of the permutation is immaterial. -/
theorem exists_column_linearEquiv [Finite E] (F : Subfield E) (v : I → E)
    (hspan : Function.Surjective (columnEval F v)) (σ : Equiv.Perm I)
    (hσ : preservesRelations F v σ) :
    ∃ T : E ≃ₗ[F] E, ∀ c : I → F,
      T (columnEval F v c) = columnEval F v (c ∘ σ) := by
  let g := (columnEval F v).comp (permuteCoeffs F σ)
  have hker : LinearMap.ker (columnEval F v) ≤ LinearMap.ker g := by
    intro c hc
    exact (hσ c).1 hc
  let T : E →ₗ[F] E := (columnEval F v).liftOfSurjective hspan ⟨g, hker⟩
  have hT (c : I → F) : T (columnEval F v c) = columnEval F v (c ∘ σ) := by
    exact LinearMap.equivOfSurjective_apply _ _
  have hinj : Function.Injective T := by
    apply (LinearMap.ker_eq_bot).1
    apply eq_bot_iff.mpr
    intro x hx
    obtain ⟨c, rfl⟩ := hspan x
    have hc : (c ∘ σ) ∈ relationCode F v := by
      change columnEval F v (c ∘ σ) = 0
      simpa only [LinearMap.mem_ker, hT] using hx
    change columnEval F v c = 0
    exact (hσ c).2 hc
  exact ⟨LinearEquiv.ofBijective T ⟨hinj, Finite.surjective_of_injective hinj⟩, hT⟩

/-- The induced linear equivalence sends each individual column to the
column indexed by the inverse coordinate permutation. -/
theorem exists_column_linearEquiv_apply [Finite E] (F : Subfield E) (v : I → E)
    (hspan : Function.Surjective (columnEval F v)) (σ : Equiv.Perm I)
    (hσ : preservesRelations F v σ) :
    ∃ T : E ≃ₗ[F] E, ∀ i : I, T (v i) = v (σ.symm i) := by
  classical
  obtain ⟨T, hT⟩ := exists_column_linearEquiv F v hspan σ hσ
  refine ⟨T, fun i => ?_⟩
  simpa only [columnEval_single, columnEval_permute_single] using hT (Pi.single i 1)

/-- Conversely, an invertible row transformation inducing a column
permutation preserves exactly the coefficient-relation code. -/
theorem preservesRelations_of_column_linearEquiv (F : Subfield E) (v : I → E)
    (σ : Equiv.Perm I) (T : E ≃ₗ[F] E)
    (hT : ∀ i : I, T (v i) = v (σ.symm i)) : preservesRelations F v σ := by
  intro c
  have heq : T (columnEval F v c) = columnEval F v (c ∘ σ) := by
    rw [columnEval_permute]
    change T (∑ i, c i • v i) = ∑ i, c i • v (σ.symm i)
    simp only [map_sum, map_smul, hT]
  change columnEval F v c = 0 ↔ columnEval F v (c ∘ σ) = 0
  rw [← heq]
  exact T.map_eq_zero_iff.symm

end NSDensity.Concrete

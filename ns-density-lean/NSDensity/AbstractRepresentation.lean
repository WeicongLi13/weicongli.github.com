import NSDensity.ConcreteIrreducible
import Mathlib.RingTheory.IntegralDomain

open scoped IsMulCommutative
open Fin.NatCast

namespace NSDensity.Concrete

universe u

section AbstractRepresentation

variable {F : Type u} [Field F] {n : ℕ}

/-- The coordinate shift restricted to a cyclic code. -/
def codeShift (C : Submodule F (Fin n → F)) (hC : cyclicCode C) : Module.End F C where
  toFun w := ⟨w.val ∘ finRotate n, hC w.val w.property⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp] theorem codeShift_apply (C : Submodule F (Fin n → F)) (hC : cyclicCode C)
    (w : C) (i : Fin n) : (codeShift C hC w).val i = w.val (finRotate n i) := rfl

theorem codeShift_pow_apply [NeZero n] (C : Submodule F (Fin n → F))
    (hC : cyclicCode C) (k : ℕ) (w : C) (i : Fin n) :
    (((codeShift C hC) ^ k) w).val i = w.val (i + (k : Fin n)) := by
  induction k generalizing i with
  | zero => simp
  | succ k hk =>
    rw [pow_succ', Module.End.mul_apply, codeShift_apply, hk, finRotate_apply]
    simp [Nat.cast_add, add_comm, add_left_comm]

theorem codeShift_pow_length [NeZero n] (C : Submodule F (Fin n → F))
    (hC : cyclicCode C) : (codeShift C hC) ^ n = 1 := by
  ext w i
  simp [codeShift_pow_apply]

/-- Schur's elementary kernel argument for endomorphisms commuting with the shift. -/
theorem codeShift_commuting_injective (C : Submodule F (Fin n → F))
    (hC : irreducibleCyclicCode C) (b : Module.End F C)
    (hcomm : Commute (codeShift C hC.2.1) b) (hb : b ≠ 0) :
    Function.Injective b := by
  let D : Submodule F (Fin n → F) := b.ker.map C.subtype
  have hle : D ≤ C := Submodule.map_subtype_le C b.ker
  have hcyc : cyclicCode D := by
    rintro w ⟨x, hx, rfl⟩
    refine ⟨codeShift C hC.2.1 x, ?_, rfl⟩
    change b (codeShift C hC.2.1 x) = 0
    have hh := LinearMap.congr_fun hcomm.eq x
    change codeShift C hC.2.1 (b x) = b (codeShift C hC.2.1 x) at hh
    rw [← hh, (LinearMap.mem_ker.mp hx), map_zero]
  rcases hC.2.2 D hle hcyc with hzero | hall
  · apply LinearMap.ker_eq_bot.mp
    apply eq_bot_iff.mpr
    intro x hx
    have hxd : x.val ∈ D := ⟨x, hx, rfl⟩
    rw [hzero] at hxd
    change x = 0
    exact Subtype.ext ((Submodule.mem_bot F).mp hxd)
  · exfalso
    apply hb
    apply LinearMap.ext
    intro x
    have hxd : x.val ∈ D := by rw [hall]; exact x.property
    obtain ⟨y, hy, hxy⟩ := hxd
    have hyx : y = x := Subtype.ext hxy
    subst y
    exact hy

/-- The finite algebra generated by the shift on an irreducible cyclic code
has no zero divisors. -/
theorem codeShiftAlgebra_noZeroDivisors (C : Submodule F (Fin n → F))
    (hC : irreducibleCyclicCode C) :
    NoZeroDivisors (Algebra.adjoin F {codeShift C hC.2.1}) := by
  refine ⟨fun {x y} hxy => ?_⟩
  by_cases hx : x = 0
  · exact Or.inl hx
  · right
    have hxi : Function.Injective x.val := codeShift_commuting_injective C hC x.val
      (Algebra.commute_of_mem_adjoin_self x.property)
      (fun h => hx (Subtype.ext h))
    apply Subtype.ext
    apply LinearMap.ext
    intro w
    apply hxi
    have hh := congrArg (fun z : Algebra.adjoin F {codeShift C hC.2.1} => z.val w) hxy
    simpa using hh

/-- Every nondegenerate irreducible cyclic code is a root-column code over
a finite extension of its coefficient field. This is a converse for arbitrary
linear subspaces, rather than an assumption that the code already has a root model. -/
theorem irreducibleCyclicCode_exists_root_model [Finite F]
    (C : Submodule F (Fin n → F)) (hC : irreducibleCyclicCode C)
    (hnd : nondegenerateCode C) :
    ∃ (E : Type u) (fieldE : Field E),
      letI := fieldE
      ∃ (_finiteE : Finite E) (algebraFE : Algebra F E),
        letI := algebraFE
        ∃ a : E, orderOf a = n ∧
          C = functionalCodeOver (F := F) (fun i : Fin n => a ^ i.val) := by
  classical
  have hn : 0 < n := by
    by_contra hn
    have hn0 : n = 0 := Nat.eq_zero_of_not_pos hn
    subst n
    exact hC.1 C.eq_bot_of_subsingleton
  let : NeZero n := ⟨hn.ne'⟩
  let : Nontrivial C := (Submodule.nontrivial_iff_ne_bot).mpr hC.1
  let : Ring (Module.End F C) := inferInstance
  let : Semiring (Module.End F C) := (inferInstance : Ring (Module.End F C)).toSemiring
  let K := Algebra.adjoin F {codeShift C hC.2.1}
  let : IsMulCommutative K := Algebra.isMulCommutative_adjoin_singleton F _
  let : CommRing K := inferInstance
  let : NoZeroDivisors K := codeShiftAlgebra_noZeroDivisors C hC
  let : Nontrivial K := inferInstance
  let : IsDomain K := NoZeroDivisors.to_isDomain K
  let : Finite (Module.End F C) :=
    Finite.of_injective (fun f : Module.End F C => (f : C → C)) LinearMap.coe_injective
  let : Finite K := Finite.of_injective (fun b : K => b.val) Subtype.val_injective
  let : Field K := (Finite.isField_of_domain K).toField
  let a : K := ⟨codeShift C hC.2.1, Algebra.subset_adjoin (Set.mem_singleton _)⟩
  have hpow : a ^ n = 1 := by
    apply Subtype.ext
    exact codeShift_pow_length C hC.2.1
  have hspan : Submodule.span F (Set.range fun k : ℕ => a ^ k) = ⊤ := by
    have hp : Submodule.span F (Set.range fun k : ℕ => (codeShift C hC.2.1) ^ k) =
        (Algebra.adjoin F {codeShift C hC.2.1}).toSubmodule := by
      rw [Algebra.adjoin_eq_span, ← Submonoid.powers_eq_closure]
      rfl
    exact (Submodule.span_range_subtype_eq_top_iff
      (Algebra.adjoin F {codeShift C hC.2.1}).toSubmodule
      (fun k : ℕ => pow_mem (Algebra.subset_adjoin (Set.mem_singleton _)) k)).2 hp
  have hsub : C ≤ functionalCodeOver (F := F) (fun i : Fin n => a ^ i.val) := by
    intro w hw
    let φ : K →ₗ[F] F :=
      { toFun := fun b => (b.val ⟨w, hw⟩).val 0
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    refine ⟨φ, ?_⟩
    ext i
    change (((codeShift C hC.2.1) ^ i.val) ⟨w, hw⟩).val 0 = w i
    simpa using codeShift_pow_apply C hC.2.1 i.val ⟨w, hw⟩ 0
  have hcode : C = functionalCodeOver (F := F) (fun i : Fin n => a ^ i.val) :=
    (functionalCodeOver_irreducible hn a hpow hspan C hsub hC.2.1).resolve_left hC.1
  have ha : orderOf a = n := by
    apply le_antisymm (orderOf_le_of_pow_eq_one hn hpow)
    by_contra hle
    have hlt : orderOf a < n := Nat.lt_of_not_ge hle
    have hpos : 0 < orderOf a := orderOf_pos_iff.mpr
      (isOfFinOrder_iff_pow_eq_one.mpr ⟨n, hn, hpow⟩)
    let j : Fin n := ⟨orderOf a, hlt⟩
    have hj : (0 : Fin n) ≠ j := by
      intro hh
      have hv := congrArg Fin.val hh
      exact hpos.ne' (by simpa [j] using hv.symm)
    obtain ⟨w, hw, hdiff⟩ := hnd 0 j hj
    obtain ⟨φ, hφ⟩ := hsub hw
    have hzero := congrFun hφ (0 : Fin n)
    have hjval := congrFun hφ j
    apply hdiff
    change φ (a ^ (0 : Fin n).val) = w 0 at hzero
    change φ (a ^ orderOf a) = w j at hjval
    simp only [Fin.val_zero, pow_zero, pow_orderOf_eq_one] at hzero hjval
    exact hzero.symm.trans hjval
  exact ⟨K, inferInstance, inferInstance, inferInstance, a, ha, hcode⟩

end AbstractRepresentation

end NSDensity.Concrete

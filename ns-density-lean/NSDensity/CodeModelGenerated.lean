import NSDensity.CodeModelStandard
import Mathlib.FieldTheory.IntermediateField.Algebraic

open scoped BigOperators

namespace NSDensity.Concrete

variable {E : Type*} [Field E] [Finite E]

/-- The field generated by the chosen root over the coefficient field.
Using this field removes any assumption that the ambient field is minimal. -/
noncomputable def rootField (F : Type*) [Field F] [Algebra F E] (a : E) :
    IntermediateField F E :=
  Algebra.IsAlgebraic.toIntermediateField (Algebra.adjoin F {a})

def rootInField (F : Type*) [Field F] [Algebra F E] (a : E) : rootField F a :=
  ⟨a, Algebra.subset_adjoin (Set.mem_singleton a)⟩

theorem rootInField_powers_span (F : Type*) [Field F] [Algebra F E] (a : E) :
    Submodule.span F (Set.range fun k : ℕ => (rootInField F a) ^ k) = ⊤ := by
  have hp : Submodule.span F (Set.range fun k : ℕ => a ^ k) =
      (Algebra.adjoin F {a}).toSubmodule := by
    rw [Algebra.adjoin_eq_span, ← Submonoid.powers_eq_closure]
    rfl
  exact (Submodule.span_range_subtype_eq_top_iff
    (Algebra.adjoin F {a}).toSubmodule
    (fun k : ℕ => pow_mem (Algebra.subset_adjoin (Set.mem_singleton a)) k)).2 hp

theorem columnEvalOver_single {F K I : Type*} [Field F] [Field K] [Algebra F K]
    [Fintype I] [DecidableEq I] (v : I → K) (i : I) :
    columnEvalOver (F := F) v (Pi.single i 1) = v i := by
  change (∑ j, (Pi.single i (1 : F) : I → F) j • v j) = v i
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hj; simp [hj]
  · simp

theorem columnEvalOver_surjective_of_powers_span {F K : Type*} [Field F] [Field K]
    [Algebra F K] {a : K} {n : ℕ} (hn : 0 < n) (ha : orderOf a = n)
    (hspan : Submodule.span F (Set.range fun k : ℕ => a ^ k) = ⊤) :
    Function.Surjective (columnEvalOver (F := F) (fun i : Fin n => a ^ i.val)) := by
  apply LinearMap.range_eq_top.1
  apply top_unique
  rw [← hspan]
  apply Submodule.span_le.mpr
  rintro _ ⟨k, rfl⟩
  let i : Fin n := ⟨k % n, Nat.mod_lt _ hn⟩
  refine ⟨Pi.single i 1, ?_⟩
  rw [columnEvalOver_single]
  simpa only [i, ha] using pow_mod_orderOf a k

theorem rootInField_orderOf (F : Type*) [Field F] [Algebra F E] (a : E) :
    orderOf (rootInField F a) = orderOf a := by
  exact (orderOf_injective (rootField F a).val.toMonoidHom Subtype.val_injective _).symm

/-- Affine automorphisms of the root relation code are standard, without
any spanning assumption on the original ambient field. -/
theorem affine_preservesRelations_is_standard_unrestricted (F : Subfield E) [Fintype F]
    {a : E} {n : ℕ} (hn : 0 < n) (ha : orderOf a = n)
    (σ : Equiv.Perm (Fin n))
    (hσ : preservesRelations F (fun i : Fin n => a ^ i.val) σ)
    (hAffine : affinePermutation n σ) : standardPermutation (Fintype.card F) n σ := by
  let K := rootField F a
  let a' : K := rootInField F a
  have ha' : orderOf a' = n := (rootInField_orderOf F a).trans ha
  have hspan := rootInField_powers_span F a
  have heval := columnEvalOver_surjective_of_powers_span hn ha' hspan
  have hinv : preservesRelations F (fun i : Fin n => a ^ i.val) σ.symm :=
    (permutationAutGroup F (fun i : Fin n => a ^ i.val)).inv_mem hσ
  have hrel : ∀ c : Fin n → F,
      columnEvalOver (fun i : Fin n => a' ^ i.val) c = 0 ↔
        columnEvalOver (fun i : Fin n => a' ^ i.val) (c ∘ σ.symm) = 0 := by
    intro c
    have hcoe (d : Fin n → F) :
        columnEvalOver (fun i : Fin n => a' ^ i.val) d = 0 ↔
          d ∈ relationCode F (fun i : Fin n => a ^ i.val) := by
      rw [← Subtype.coe_inj]
      change ((∑ i, d i • a' ^ i.val : K) : E) = 0 ↔ _
      simp [relationCode, rootInField, a', K, Algebra.smul_def]
      rfl
    exact (hcoe c).trans ((hinv c).trans (hcoe (c ∘ σ.symm)).symm)
  obtain ⟨T, hT⟩ := exists_column_linearEquiv_over (F := F)
    (fun i : Fin n => a' ^ i.val) heval σ.symm hrel
  simp only [Equiv.symm_symm] at hT
  exact linearEquiv_affine_powers_is_standard hn ha' hspan T σ hT hAffine

theorem standardPermutation_is_affine {q n : ℕ} (hcop : Nat.Coprime q n)
    {σ : Equiv.Perm (Fin n)} (h : standardPermutation q n σ) : affinePermutation n σ := by
  obtain ⟨j, b, h⟩ := h
  refine ⟨ZMod.unitOfCoprime q hcop ^ j, b, fun i => ?_⟩
  simpa only [Units.val_pow_eq_pow_val, ZMod.coe_unitOfCoprime] using h i

/-- Every ordinary shift/Frobenius permutation really is an automorphism
of the root relation code. -/
theorem standardPermutation_preservesRelations (F : Subfield E) [Fintype F]
    {a : E} {n : ℕ} (hn : 0 < n) (ha : orderOf a = n)
    {σ : Equiv.Perm (Fin n)} (h : standardPermutation (Fintype.card F) n σ) :
    preservesRelations F (fun i : Fin n => a ^ i.val) σ := by
  let : NeZero n := ⟨hn.ne'⟩
  obtain ⟨j, b, hσ⟩ := h
  have ha0 : a ≠ 0 := (orderOf_pos_iff.mp (ha.symm ▸ hn)).isUnit.ne_zero
  let e : E ≃ₐ[F] E := FiniteField.frobeniusAlgEquivOfAlgebraic F E ^ j
  let T : E ≃ₗ[F] E := e.toLinearEquiv.trans
    ((LinearEquiv.smulOfNeZero E E (a ^ b.val) (pow_ne_zero _ ha0)).restrictScalars F)
  have he (x : E) : e x = x ^ (Fintype.card F ^ j) := by
    simp only [e, AlgEquiv.coe_pow,
      FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate]
  have hT : ∀ i : Fin n, T (a ^ i.val) = a ^ (σ i).val := by
    intro i
    change a ^ b.val * e (a ^ i.val) = a ^ (σ i).val
    rw [he, ← pow_mul, ← pow_add]
    apply (root_pow_eq_iff_zmod hn ha).2
    simpa [Nat.cast_add, Nat.cast_mul, Nat.cast_pow, ZMod.natCast_zmod_val,
      mul_comm, add_comm] using (hσ i).symm
  have hinv : preservesRelations F (fun i : Fin n => a ^ i.val) σ.symm :=
    preservesRelations_of_column_linearEquiv F _ σ.symm T (by simpa using hT)
  intro c
  simpa [Function.comp_def] using (hinv (c ∘ σ)).symm

/-- The standard group is exactly the intersection of the actual
permutation automorphism group with the affine coordinate permutations. -/
theorem standardPermutation_iff_affine_automorphism (F : Subfield E) [Fintype F]
    {a : E} {n : ℕ} (hn : 0 < n) (ha : orderOf a = n)
    (hcop : Nat.Coprime (Fintype.card F) n) (σ : Equiv.Perm (Fin n)) :
    standardPermutation (Fintype.card F) n σ ↔
      preservesRelations F (fun i : Fin n => a ^ i.val) σ ∧ affinePermutation n σ := by
  constructor
  · intro h
    exact ⟨standardPermutation_preservesRelations F hn ha h,
      standardPermutation_is_affine hcop h⟩
  · rintro ⟨hσ, hAffine⟩
    exact affine_preservesRelations_is_standard_unrestricted F hn ha σ hσ hAffine

/-- The concrete exceptional-code condition agrees with the ordinary
definition: its permutation group contains a permutation outside the
standard shift/Frobenius group. -/
theorem nonstandardRootCode_iff_outside_standard (F : Subfield E) [Fintype F]
    {a : E} {n : ℕ} (hn : 0 < n) (ha : orderOf a = n)
    (hcop : Nat.Coprime (Fintype.card F) n) :
    nonstandardRootCode F n a ↔
      ∃ σ : Equiv.Perm (Fin n),
        preservesRelations F (fun i : Fin n => a ^ i.val) σ ∧
          ¬standardPermutation (Fintype.card F) n σ := by
  constructor
  · rintro ⟨σ, hσ, hnonaffine⟩
    exact ⟨σ, hσ, fun hstd => hnonaffine (standardPermutation_is_affine hcop hstd)⟩
  · rintro ⟨σ, hσ, hnonstandard⟩
    exact ⟨σ, hσ, fun haff => hnonstandard
      (affine_preservesRelations_is_standard_unrestricted F hn ha σ hσ haff)⟩

end NSDensity.Concrete

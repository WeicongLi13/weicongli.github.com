import NSDensity.ConcreteCyclic
import NSDensity.CodeModelGenerated

/-! Irreducibility of the cyclic code generated by an exact-order root. -/

namespace NSDensity.Concrete

section Generic

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- Right multiplication, as a linear map over the coefficient field. -/
def multiplyRight (a : E) : E →ₗ[F] E where
  toFun x := x * a
  map_add' _ _ := add_mul _ _ _
  map_smul' r x := by simp [Algebra.smul_def, mul_assoc]

/-- The dual of a simple field extension has no proper nonzero subspace
stable under multiplication by its generating element. -/
theorem dual_invariant_eq_bot_or_top [FiniteDimensional F E] (a : E)
    (hspan : Submodule.span F (Set.range fun k : ℕ => a ^ k) = ⊤)
    (D : Submodule F (E →ₗ[F] F))
    (hD : ∀ φ ∈ D, φ.comp (multiplyRight (F := F) a) ∈ D) :
    D = ⊥ ∨ D = ⊤ := by
  let A := D.dualCoannihilator
  have hA_mul (x : E) (hx : x ∈ A) : ∀ b : E, b * x ∈ A := by
    have hpowers (k : ℕ) : a ^ k * x ∈ A := by
      induction k with
      | zero => simpa using hx
      | succ k hk =>
        rw [Submodule.mem_dualCoannihilator]
        intro φ hφ
        have hh := (Submodule.mem_dualCoannihilator _).1 hk
          (φ.comp (multiplyRight (F := F) a)) (hD φ hφ)
        simpa [multiplyRight, pow_succ, mul_assoc, mul_comm, mul_left_comm] using hh
    intro b
    have hb : b ∈ Submodule.span F (Set.range fun k : ℕ => a ^ k) := by
      rw [hspan]
      trivial
    induction hb using Submodule.span_induction with
    | mem b hb => obtain ⟨k, rfl⟩ := hb; exact hpowers k
    | zero => simp
    | add b c hb hc ihb ihc => simpa [add_mul] using A.add_mem ihb ihc
    | smul r b hb ih => simpa [smul_mul_assoc] using A.smul_mem r ih
  by_cases hA : A = ⊥
  · right
    have hh := Subspace.dualCoannihilator_dualAnnihilator_eq (W := D)
    change A.dualAnnihilator = D at hh
    simpa [hA] using hh.symm
  · left
    obtain ⟨x, hx, hxn⟩ := A.ne_bot_iff.mp hA
    have hAll (y : E) : y ∈ A := by
      have hh := hA_mul x hx (y * x⁻¹)
      simpa [mul_assoc, hxn] using hh
    apply eq_bot_iff.mpr
    intro φ hφ
    change φ = 0
    ext y
    exact (Submodule.mem_dualCoannihilator y).1 (hAll y) φ hφ

end Generic

section RowCode

variable {F V : Type*} [Field F] [AddCommGroup V] [Module F V]
variable {I : Type*}

/-- Generator evaluation over an arbitrary coefficient-field embedding. -/
def functionalEvaluationOver (v : I → V) : (V →ₗ[F] F) →ₗ[F] (I → F) where
  toFun φ i := φ (v i)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def functionalCodeOver (v : I → V) : Submodule F (I → F) :=
  LinearMap.range (functionalEvaluationOver (F := F) v)

/-- Injectively embedding the column space leaves the actual row code
unchanged. Every functional on the embedded subspace extends linearly. -/
theorem functionalCodeOver_embedding {W : Type*} [AddCommGroup W] [Module F W]
    (e : V →ₗ[F] W) (he : Function.Injective e) (v : I → V) :
    functionalCodeOver (F := F) (fun i => e (v i)) = functionalCodeOver (F := F) v := by
  obtain ⟨s, hs⟩ := e.exists_leftInverse_of_injective (LinearMap.ker_eq_bot.mpr he)
  apply le_antisymm
  · rintro _ ⟨φ, rfl⟩
    exact ⟨φ.comp e, rfl⟩
  · rintro _ ⟨φ, rfl⟩
    refine ⟨φ.comp s, ?_⟩
    ext i
    exact congrArg φ (LinearMap.congr_fun hs (v i))

end RowCode

section Irreducible

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- An exact-order root that generates the field produces an irreducible
cyclic code: each shift-invariant subcode is zero or the whole code. -/
theorem functionalCodeOver_irreducible [FiniteDimensional F E]
    {n : ℕ} (hn : 0 < n) (a : E) (ha : a ^ n = 1)
    (hspan : Submodule.span F (Set.range fun k : ℕ => a ^ k) = ⊤)
    (C : Submodule F (Fin n → F))
    (hC : C ≤ functionalCodeOver (F := F) (fun i : Fin n => a ^ i.val))
    (hrot : ∀ w ∈ C, (w ∘ finRotate n) ∈ C) :
    C = ⊥ ∨ C = functionalCodeOver (F := F) (fun i : Fin n => a ^ i.val) := by
  let ev := functionalEvaluationOver (F := F) (fun i : Fin n => a ^ i.val)
  let D : Submodule F (E →ₗ[F] F) := C.comap ev
  have hD : ∀ φ ∈ D, φ.comp (multiplyRight (F := F) a) ∈ D := by
    intro φ hφ
    change ev (φ.comp (multiplyRight (F := F) a)) ∈ C
    have hh := hrot (ev φ) hφ
    convert hh using 1
    ext i
    change φ (a ^ i.val * a) = φ (a ^ (finRotate n i).val)
    exact congrArg φ (root_pow_rotate a hn ha i).symm
  rcases dual_invariant_eq_bot_or_top a hspan D hD with hDzero | hDtop
  · left
    apply eq_bot_iff.mpr
    intro w hw
    obtain ⟨φ, hφ⟩ := hC hw
    change ev φ = w at hφ
    have hφD : φ ∈ D := by change ev φ ∈ C; simpa only [hφ] using hw
    have hz : φ = 0 := by simpa [hDzero] using hφD
    change w = 0
    rw [← hφ, hz]
    rfl
  · right
    apply le_antisymm hC
    rintro w ⟨φ, hφ⟩
    change ev φ = w at hφ
    have hφD : φ ∈ D := by rw [hDtop]; trivial
    change ev φ ∈ C at hφD
    simpa only [hφ] using hφD

end Irreducible

/-- The actual root-column code is irreducible even when its ambient field
is larger than the field generated by the root. -/
theorem rootFunctionalCode_irreducible {E : Type*} [Field E] [Finite E]
    (F : Subfield E) {n : ℕ} (hn : 0 < n) (a : E) (ha : a ^ n = 1)
    (C : Submodule F (Fin n → F)) (hC : C ≤ rootFunctionalCode F n a)
    (hrot : ∀ w ∈ C, (w ∘ finRotate n) ∈ C) :
    C = ⊥ ∨ C = rootFunctionalCode F n a := by
  let K := rootField F a
  let a' : K := rootInField F a
  let e : K →ₗ[F] E := (rootField F a).val.toLinearMap
  have hcols (i : Fin n) : e (a' ^ i.val) = a ^ i.val := by
    simp [e, a', rootInField]
  have hcode : rootFunctionalCode F n a =
      functionalCodeOver (F := F) (fun i : Fin n => a' ^ i.val) := by
    change functionalCodeOver (F := F) (fun i : Fin n => a ^ i.val) = _
    have hh := functionalCodeOver_embedding e Subtype.val_injective
      (fun i : Fin n => a' ^ i.val)
    simpa only [hcols] using hh
  have ha' : a' ^ n = 1 := by
    apply Subtype.val_injective
    exact ha
  have hh := functionalCodeOver_irreducible hn a' ha'
    (rootInField_powers_span F a) C (hcode ▸ hC) hrot
  simpa only [← hcode] using hh

/-- A cyclic linear code is closed under cyclic coordinate shift. -/
def cyclicCode {F : Type*} [Field F] {n : ℕ} (C : Submodule F (Fin n → F)) : Prop :=
  ∀ w ∈ C, (w ∘ finRotate n) ∈ C

/-- Irreducibility means that the nonzero cyclic code has no proper
nonzero cyclic subcode. -/
def irreducibleCyclicCode {F : Type*} [Field F] {n : ℕ}
    (C : Submodule F (Fin n → F)) : Prop :=
  C ≠ ⊥ ∧ cyclicCode C ∧
    ∀ D : Submodule F (Fin n → F), D ≤ C → cyclicCode D → D = ⊥ ∨ D = C

/-- Nondegeneracy: different positions are distinguished by some codeword.
For root-column cyclic codes this is exactly exact order of the check root. -/
def nondegenerateCode {F : Type*} [Field F] {n : ℕ}
    (C : Submodule F (Fin n → F)) : Prop :=
  ∀ i j : Fin n, i ≠ j → ∃ w ∈ C, w i ≠ w j

/-- The concrete root-column code really is a nondegenerate irreducible
cyclic code, not merely a named predicate on the pair (n,q). -/
theorem rootFunctionalCode_is_nondegenerate_irreducible {E : Type*}
    [Field E] [Finite E] (F : Subfield E) {n : ℕ} (hn : 0 < n)
    (a : E) (ha : orderOf a = n) :
    irreducibleCyclicCode (rootFunctionalCode F n a) ∧
      nondegenerateCode (rootFunctionalCode F n a) := by
  have hpow : a ^ n = 1 := ha ▸ pow_orderOf_eq_one a
  refine ⟨⟨?_, ?_, ?_⟩, ?_⟩
  · intro hzero
    obtain ⟨w, hw, hone⟩ := rootFunctionalCode_has_one F a hn
    have hwzero : w = 0 := by simpa [hzero] using hw
    have hh := congrFun hwzero ⟨0, hn⟩
    rw [hone] at hh
    exact one_ne_zero hh
  · intro w hw
    exact (rootFunctionalCode_cyclic F a hn hpow w).1 hw
  · intro D hD hrot
    exact rootFunctionalCode_irreducible F hn a hpow D hD hrot
  · intro i j hij
    exact rootFunctionalCode_separates_coordinates F a ha hij

/-- The concrete exceptional-root predicate is exactly the existence of
a non-affine permutation automorphism of the actual irreducible code. -/
theorem nonstandardRootCode_iff_functionalCode {E : Type*} [Field E]
    (F : Subfield E) (n : ℕ) (a : E) :
    nonstandardRootCode F n a ↔
      ∃ σ : Equiv.Perm (Fin n),
        preservesCode F (rootFunctionalCode F n a) σ ∧ ¬affinePermutation n σ := by
  constructor
  · rintro ⟨σ, hσ, hnonaffine⟩
    exact ⟨σ, (preservesRelations_iff_preserves_functionalCode_general F
      (fun i : Fin n => a ^ i.val) σ).1 hσ, hnonaffine⟩
  · rintro ⟨σ, hσ, hnonaffine⟩
    exact ⟨σ, (preservesRelations_iff_preserves_functionalCode_general F
      (fun i : Fin n => a ^ i.val) σ).2 hσ, hnonaffine⟩

/-- The standard group description also holds on the actual generator
code, by the proved equality of its permutation group with that of its dual. -/
theorem nonstandardRootCode_iff_functionalCode_outside_standard {E : Type*}
    [Field E] [Finite E] (F : Subfield E) [Fintype F]
    {a : E} {n : ℕ} (hn : 0 < n) (ha : orderOf a = n)
    (hcop : Nat.Coprime (Fintype.card F) n) :
    nonstandardRootCode F n a ↔
      ∃ σ : Equiv.Perm (Fin n),
        preservesCode F (rootFunctionalCode F n a) σ ∧
          ¬standardPermutation (Fintype.card F) n σ := by
  rw [nonstandardRootCode_iff_outside_standard F hn ha hcop]
  constructor
  · rintro ⟨σ, hσ, hnonstandard⟩
    exact ⟨σ, (preservesRelations_iff_preserves_functionalCode_general F
      (fun i : Fin n => a ^ i.val) σ).1 hσ, hnonstandard⟩
  · rintro ⟨σ, hσ, hnonstandard⟩
    exact ⟨σ, (preservesRelations_iff_preserves_functionalCode_general F
      (fun i : Fin n => a ^ i.val) σ).2 hσ, hnonstandard⟩

/-- Every concrete nonstandard pair supplies a genuine nondegenerate,
irreducible cyclic code and an actual non-affine automorphism of that code. -/
theorem nonstandardPair_code_witness {E : Type*} [Field E] [Finite E]
    (F : Subfield E) {n : ℕ} (hn : 0 < n) (h : nonstandardPair F n) :
    ∃ a : E, orderOf a = n ∧
      irreducibleCyclicCode (rootFunctionalCode F n a) ∧
      nondegenerateCode (rootFunctionalCode F n a) ∧
      ∃ σ : Equiv.Perm (Fin n),
        preservesCode F (rootFunctionalCode F n a) σ ∧ ¬affinePermutation n σ := by
  obtain ⟨a, ha, hNS⟩ := h
  obtain ⟨hirr, hnondeg⟩ := rootFunctionalCode_is_nondegenerate_irreducible F hn a ha
  exact ⟨a, ha, hirr, hnondeg, (nonstandardRootCode_iff_functionalCode F n a).1 hNS⟩

end NSDensity.Concrete

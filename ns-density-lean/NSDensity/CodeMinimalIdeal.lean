import Mathlib.RingTheory.AdjoinRoot
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
The ideal generated by g in F[X]/(f*g), for irreducible f and nonzero g,
is a minimal nonzero ideal. This is the elementary ideal argument needed
to identify the actual inverse-root row code with the paper's principal
ideal. No classification or density assumption occurs here.
-/

namespace NSDensity.Concrete

variable {F : Type*} [Field F]

/-- The principal ideal generated by the cofactor is a minimal ideal. -/
theorem minimalIdeal_eq_of_ne_bot (f g : Polynomial F) (hf : Irreducible f)
    (I : Ideal (AdjoinRoot (f * g)))
    (hle : I ≤ Ideal.span ({AdjoinRoot.mk (f * g) g} : Set (AdjoinRoot (f * g))))
    (hI : I ≠ ⊥) :
    I = Ideal.span ({AdjoinRoot.mk (f * g) g} : Set (AdjoinRoot (f * g))) := by
  obtain ⟨x, hx, hxzero⟩ := I.ne_bot_iff.mp hI
  obtain ⟨kQ, rfl⟩ := Ideal.mem_span_singleton.mp (hle hx)
  obtain ⟨k, rfl⟩ := AdjoinRoot.mk_surjective (g := f * g) kQ
  have hfk : ¬f ∣ k := by
    rintro ⟨l, hl⟩
    apply hxzero
    rw [← map_mul]
    apply AdjoinRoot.mk_eq_zero.mpr
    refine ⟨l, ?_⟩
    rw [hl]
    ring
  obtain ⟨s, t, hst⟩ := hf.coprime_iff_not_dvd.mpr hfk
  have hgen : AdjoinRoot.mk (f * g) g =
      AdjoinRoot.mk (f * g) t *
        (AdjoinRoot.mk (f * g) g * AdjoinRoot.mk (f * g) k) := by
    simp only [← map_mul]
    apply AdjoinRoot.mk_eq_mk.mpr
    refine ⟨s, ?_⟩
    calc
      g - t * (g * k) = (s * f + t * k) * g - t * (g * k) := by rw [hst]; simp
      _ = (f * g) * s := by ring
  apply le_antisymm hle
  apply Ideal.span_le.mpr
  intro y hy
  obtain rfl := Set.mem_singleton_iff.mp hy
  rw [hgen]
  exact I.mul_mem_left _ hx

/-- The cofactor ideal is nonzero as soon as the cofactor is nonzero. -/
theorem minimalIdeal_ne_bot (f g : Polynomial F) (hf : Irreducible f) (hg : g ≠ 0) :
    Ideal.span ({AdjoinRoot.mk (f * g) g} : Set (AdjoinRoot (f * g))) ≠ ⊥ := by
  intro hz
  have hmem : AdjoinRoot.mk (f * g) g ∈
      Ideal.span ({AdjoinRoot.mk (f * g) g} : Set (AdjoinRoot (f * g))) :=
    Ideal.subset_span (Set.mem_singleton _)
  have hmk : AdjoinRoot.mk (f * g) g = 0 := by simpa [hz] using hmem
  have hdiv : f * g ∣ 1 * g := by simpa using AdjoinRoot.mk_eq_zero.mp hmk
  have hfdiv : f ∣ 1 := (mul_dvd_mul_iff_right hg).mp hdiv
  exact hf.not_isUnit (isUnit_of_dvd_one hfdiv)

/-- The same minimality statement with a separately named cyclic modulus. -/
theorem minimalIdeal_eq_of_ne_bot_of_factor (h f g : Polynomial F)
    (hfg : f * g = h) (hf : Irreducible f) (I : Ideal (AdjoinRoot h))
    (hle : I ≤ Ideal.span ({AdjoinRoot.mk h g} : Set (AdjoinRoot h)))
    (hI : I ≠ ⊥) : I = Ideal.span ({AdjoinRoot.mk h g} : Set (AdjoinRoot h)) := by
  subst h
  exact minimalIdeal_eq_of_ne_bot f g hf I hle hI

end NSDensity.Concrete

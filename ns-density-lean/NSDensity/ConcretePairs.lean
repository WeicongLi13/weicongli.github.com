import NSDensity.ConcreteDescent
import NSDensity.Classification
import Mathlib.FieldTheory.Finite.Basic

/-!
Finite alphabets and root-evaluation permutation codes, with no uninterpreted
nonstandardness predicate. The ambient finite field is allowed to be larger than
the field generated by the root; the evaluation kernel is unchanged by that.
-/

namespace NSDensity

def CodeNonstandardOver (E : Type) [Field E] (n q : ℕ) : Prop :=
  Finite E ∧ ∃ F : Subfield E, Finite F ∧ Nat.card F = q ∧
    Concrete.nonstandardPair F n

/-- Concrete root-code nonstandardness over a finite alphabet of cardinality q. -/
def CodeNonstandard (n q : ℕ) : Prop :=
  ∃ (E : Type) (fieldE : Field E), @CodeNonstandardOver E fieldE n q

theorem charP_of_card_prime_power (F : Type*) [Field F] [Finite F]
    {p r : ℕ} (hp : p.Prime) (hr : 0 < r) (hcard : Nat.card F = p ^ r) :
    CharP F p := by
  let := Fintype.ofFinite F
  obtain ⟨s, hs, m, hsPrime, hsize⟩ := FiniteField.card' F
  have hdiv : p ∣ s ^ (m : ℕ) := by
    rw [← hsize, ← Nat.card_eq_fintype_card, hcard]
    exact dvd_pow (dvd_refl p) hr.ne'
  have hps : p ∣ s := hp.dvd_of_dvd_pow hdiv
  have heq : p = s := (Nat.prime_dvd_prime_iff_eq hp hsPrime).mp hps
  rwa [heq]

/-- Unrestricted descent to the prime alphabet for the concrete code predicate.
Neither FHLX nor Wiertelak--Moree is needed. -/
theorem codeNonstandard_descent {p r n : ℕ} (hp : p.Prime) (hr : 0 < r)
    (h : CodeNonstandard n (p ^ r)) : CodeNonstandard n p := by
  obtain ⟨E, fieldE, hE⟩ := h
  let : Field E := fieldE
  obtain ⟨hFiniteE, F, hFiniteF, hcard, hNS⟩ := hE
  let : Finite E := hFiniteE
  let : Finite F := hFiniteF
  let : Fact p.Prime := ⟨hp⟩
  let : CharP F p := charP_of_card_prime_power F hp hr hcard
  let : CharP E p := charP_of_injective_ringHom F.subtype.injective p
  let : Fintype (⊥ : Subfield E) := Subfield.fintypeBot E p
  refine ⟨E, fieldE, hFiniteE, ⊥, inferInstance, Subfield.card_bot E p, ?_⟩
  exact Concrete.nonstandardPair_of_subfield bot_le hNS

def PrimeExceptionalLengths (p : ℕ) : Set ℕ :=
  {n | 0 < n ∧ Nat.Coprime p n ∧ CodeNonstandard n p}

/-- The equality of the two exceptional-length sets in the paper, now for an
explicit code-and-permutation predicate rather than an assumed descent rule. -/
theorem exceptionalLengths_eq_prime {p : ℕ} (hp : p.Prime) :
    ExceptionalLengths CodeNonstandard p = PrimeExceptionalLengths p := by
  ext n
  constructor
  · rintro ⟨hn, hcop, r, hr, hNS⟩
    exact ⟨hn, hcop, codeNonstandard_descent hp hr hNS⟩
  · rintro ⟨hn, hcop, hNS⟩
    exact ⟨hn, hcop, 1, by decide, by simpa only [pow_one] using hNS⟩

end NSDensity

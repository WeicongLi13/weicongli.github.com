def NSDensity.CharacteristicStandardLengths : ℕ → Set ℕ :=
fun p =>
  {n |
    p.Coprime n ∧
      ∀ (F : Type) (fieldF : Field F),
        Finite F →
          CharP F p →
            ∀ (C : Submodule F (Fin n → F)),
              NSDensity.Concrete.irreducibleCyclicCode C →
                NSDensity.Concrete.nondegenerateCode C →
                  ∀ (σ : Equiv.Perm (Fin n)),
                    (∀ (c : Fin n → F), c ∈ C ↔ c ∘ ⇑σ ∈ C) → NSDensity.Concrete.standardPermutation (Nat.card F) n σ}
NSDensity.abstract_density_main : NSDensity.FHLXOriginalInput NSDensity.PaperNonstandard →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ},
      Nat.Prime p →
        ⋃ r, NSDensity.AbstractPrimeExceptionalLengths (p ^ ↑r) = NSDensity.AbstractPrimeExceptionalLengths p ∧
          ((fun X => ↑(NSDensity.realCount (NSDensity.AbstractPrimeExceptionalLengths p) X)) =o[Filter.atTop] fun X =>
              X) ∧
            Filter.Tendsto
              (fun X =>
                ↑(NSDensity.realCount (NSDensity.CharacteristicStandardLengths p) X) /
                  ↑(NSDensity.realCount {n | p.Coprime n} X))
              Filter.atTop (nhds 1)

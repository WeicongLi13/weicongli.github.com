structure NSDensity.FHLXOriginalInput (NS : ℕ → ℕ → Prop) : Prop
number of parameters: 1
fields:
  NSDensity.FHLXOriginalInput.classification : NSDensity.FHLXOriginalClassificationInput NS
  NSDensity.FHLXOriginalInput.initial_nonstandard : ∀ (p : ℕ),
      Nat.Prime p → ∀ (a e : ℕ), NSDensity.FHLXInitial p a e → NS a (p ^ e)
  NSDensity.FHLXOriginalInput.construction_nonstandard : ∀ (p : ℕ),
      Nat.Prime p → ∀ (x y : NSDensity.Pair), NSDensity.FHLXStep p x y → NS x.1 (p ^ x.2) → NS y.1 (p ^ y.2)
constructor:
  NSDensity.FHLXOriginalInput.mk {NS : ℕ → ℕ → Prop} (classification : NSDensity.FHLXOriginalClassificationInput NS)
    (initial_nonstandard : ∀ (p : ℕ), Nat.Prime p → ∀ (a e : ℕ), NSDensity.FHLXInitial p a e → NS a (p ^ e))
    (construction_nonstandard :
      ∀ (p : ℕ),
        Nat.Prime p → ∀ (x y : NSDensity.Pair), NSDensity.FHLXStep p x y → NS x.1 (p ^ x.2) → NS y.1 (p ^ y.2)) :
    NSDensity.FHLXOriginalInput NS
def NSDensity.FHLXOriginalClassificationInput : (ℕ → ℕ → Prop) → Prop :=
fun NS =>
  ∀ (p : ℕ),
    Nat.Prime p →
      ∀ (n f : ℕ),
        0 < n →
          p.Coprime n →
            0 < f → NS n (p ^ f) → ∃ a e, NSDensity.FHLXInitial p a e ∧ NSDensity.FHLXDerived p (a, e) (n, f)
inductive NSDensity.FHLXInitialFamily : ℕ → ℕ → ℕ → Prop
number of parameters: 3
constructors:
NSDensity.FHLXInitialFamily.dual : ∀ {p a e : ℕ},
  e = 1 → Nat.Prime a → 5 ≤ a → orderOf ↑p = a - 1 → NSDensity.FHLXInitialFamily p a e
NSDensity.FHLXInitialFamily.primitive : ∀ {p a e : ℕ} (m : ℕ),
  2 ≤ m → (p ^ e, m) ≠ (2, 2) → a = p ^ (e * m) - 1 → NSDensity.FHLXInitialFamily p a e
NSDensity.FHLXInitialFamily.ovoid : ∀ {p a e : ℕ},
  a = (p ^ e - 1) * (p ^ (2 * e) + 1) → NSDensity.FHLXInitialFamily p a e
NSDensity.FHLXInitialFamily.golay_binary : ∀ {p a e : ℕ}, p = 2 → a = 23 → e = 1 → NSDensity.FHLXInitialFamily p a e
NSDensity.FHLXInitialFamily.golay_ternary : ∀ {p a e : ℕ}, p = 3 → a = 11 → e = 1 → NSDensity.FHLXInitialFamily p a e
NSDensity.FHLXInitialFamily.equally_spaced : ∀ {p a e : ℕ},
  6 ≤ a → NSDensity.EquallySpaced (p ^ e) a → NSDensity.FHLXInitialFamily p a e
inductive NSDensity.FHLXStep : ℕ → NSDensity.Pair → NSDensity.Pair → Prop
number of parameters: 1
constructors:
NSDensity.FHLXStep.lift : ∀ {p n e t : ℕ},
  0 < n → 0 < e → p.Coprime n → 0 < t → t.Coprime (orderOf (↑p ^ e)) → NSDensity.FHLXStep p (n, e) (n, e * t)
NSDensity.FHLXStep.extension : ∀ {p n e u : ℕ},
  0 < n → 0 < e → p.Coprime n → 0 < u → u ∣ (p ^ e - 1) / n.gcd (p ^ e - 1) → NSDensity.FHLXStep p (n, e) (n * u, e)
NSDensity.FHLXStep.special_descent : ∀ {p n e r : ℕ},
  4 ≤ n → 0 < e → p.Coprime n → 1 < r → r ∣ orderOf (↑p ^ e) → NSDensity.FHLXStep p (n, e * r) (n, e)
NSDensity.FHLXStep.tensor : ∀ {p n e s : ℕ},
  0 < n →
    0 < e →
      p.Coprime n →
        1 < s →
          p.Coprime s →
            1 < orderOf (↑p ^ e) →
              (orderOf (↑p ^ e)).Coprime (orderOf (↑p ^ e)) → NSDensity.FHLXStep p (n, e) (n.lcm s, e)
def NSDensity.AbstractNonstandard : ℕ → ℕ → Prop :=
fun n q =>
  ∃ F fieldF,
    Finite F ∧
      Nat.card F = q ∧
        ∃ C,
          NSDensity.Concrete.irreducibleCyclicCode C ∧
            NSDensity.Concrete.nondegenerateCode C ∧
              ∃ σ, (∀ (c : Fin n → F), c ∈ C ↔ c ∘ ⇑σ ∈ C) ∧ ¬NSDensity.Concrete.standardPermutation q n σ
def NSDensity.AllCodesStandardLengths : ℕ → Set ℕ :=
fun p =>
  {n |
    p.Coprime n ∧
      ∀ (f : ℕ),
        0 < f →
          ∀ (F : Type) (fieldF : Field F),
            Finite F →
              Nat.card F = p ^ f →
                ∀ (C : Submodule F (Fin n → F)),
                  NSDensity.Concrete.irreducibleCyclicCode C →
                    NSDensity.Concrete.nondegenerateCode C →
                      ∀ (σ : Equiv.Perm (Fin n)),
                        (∀ (c : Fin n → F), c ∈ C ↔ c ∘ ⇑σ ∈ C) → NSDensity.Concrete.standardPermutation (p ^ f) n σ}
def NSDensity.abstractRatio : ℕ → ℝ → ℝ :=
fun q X =>
  ↑(NSDensity.realCount {n | 0 < n ∧ q.Coprime n ∧ NSDensity.AbstractNonstandard n q} X) /
    ↑(NSDensity.realCount {n | q.Coprime n} X)
@NSDensity.Concrete.irreducibleCyclicCode_exists_root_model : ∀ {F : Type u_1} [inst : Field F] {n : ℕ} [Finite F]
  (C : Submodule F (Fin n → F)),
  NSDensity.Concrete.irreducibleCyclicCode C →
    NSDensity.Concrete.nondegenerateCode C →
      ∃ E fieldE,
        ∃ (_ : Finite E), ∃ algebraFE a, orderOf a = n ∧ C = NSDensity.Concrete.functionalCodeOver fun i => a ^ ↑i
@NSDensity.abstractNonstandard_iff_paper : ∀ {n q : ℕ},
  0 < n → q.Coprime n → (NSDensity.AbstractNonstandard n q ↔ NSDensity.PaperNonstandard n q)
NSDensity.abstract_density_zero : NSDensity.FHLXOriginalInput NSDensity.PaperNonstandard →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ}, Nat.Prime p → NSDensity.DensityZero (NSDensity.ExceptionalLengths NSDensity.AbstractNonstandard p)
NSDensity.abstract_density_limit : NSDensity.FHLXOriginalInput NSDensity.PaperNonstandard →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ},
      Nat.Prime p →
        Filter.Tendsto
          (fun X => ↑(NSDensity.realCount (NSDensity.ExceptionalLengths NSDensity.AbstractNonstandard p) X) / X)
          Filter.atTop (nhds 0)
NSDensity.abstract_count_isLittleO : NSDensity.FHLXOriginalInput NSDensity.PaperNonstandard →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ},
      Nat.Prime p →
        (fun X =>
            ↑(NSDensity.realCount (NSDensity.ExceptionalLengths NSDensity.AbstractNonstandard p) X)) =o[Filter.atTop]
          fun X => X
NSDensity.allCodesStandard_relative_density_one : NSDensity.FHLXOriginalInput NSDensity.PaperNonstandard →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ},
      Nat.Prime p →
        Filter.Tendsto
          (fun X =>
            ↑(NSDensity.realCount (NSDensity.AllCodesStandardLengths p) X) / ↑(NSDensity.realCount {n | p.Coprime n} X))
          Filter.atTop (nhds 1)
@NSDensity.abstractRatio_sup_eq : ∀ {p : ℕ},
  Nat.Prime p → ∀ (X : ℝ), ⨆ r, NSDensity.abstractRatio (p ^ ↑r) X = NSDensity.abstractRatio p X
NSDensity.abstractRatio_sup_tendsto_zero : NSDensity.FHLXOriginalInput NSDensity.PaperNonstandard →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ}, Nat.Prime p → Filter.Tendsto (fun X => ⨆ r, NSDensity.abstractRatio (p ^ ↑r) X) Filter.atTop (nhds 0)
@NSDensity.Concrete.liftingRootLinearGroupEquiv : {E : Type u_1} →
  [inst : Field E] →
    [inst_1 : Finite E] →
      (F K : Subfield E) →
        F ≤ K →
          {p e t n : ℕ} →
            Nat.Prime p →
              0 < e →
                Nat.card ↥F = p ^ e →
                  Nat.card ↥K = p ^ (e * t) →
                    0 < n →
                      p.Coprime n →
                        t.Coprime (orderOf (↑p ^ e)) →
                          {a : E} →
                            orderOf a = n →
                              ↥(NSDensity.columnLinearGroup fun i => NSDensity.Concrete.rootInField (↥F) a ^ ↑i) ≃*
                                ↥(NSDensity.columnLinearGroup fun i => NSDensity.Concrete.rootInField (↥K) a ^ ↑i)

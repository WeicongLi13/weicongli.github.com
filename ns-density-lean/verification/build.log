def NSDensity.DensityZero : Set ℕ → Prop :=
fun A => ∀ (ε : ℚ), 0 < ε → ∃ N, ∀ (X : ℕ), N ≤ X → ↑(NSDensity.count A X) ≤ ε * ↑X
def NSDensity.WiertelakMoreeInput : Prop :=
∀ (b h : ℕ), 1 < b → 1 < h → NSDensity.ReciprocalDiverges (NSDensity.OrderPrimes b h)
def NSDensity.FHLXInput : (ℕ → ℕ → Prop) → Prop :=
fun NS =>
  ∀ (p : ℕ),
    Nat.Prime p →
      ∀ (n f : ℕ),
        0 < n →
          p.Coprime n →
            0 < f →
              NS n (p ^ f) →
                ∃ a e, NSDensity.Initial p a e ∧ Relation.ReflTransGen (NSDensity.ClassificationStep p) (a, e) (n, f)
def NSDensity.CodeNonstandard : ℕ → ℕ → Prop :=
fun n q => ∃ E fieldE, NSDensity.CodeNonstandardOver E n q
def NSDensity.CodeNonstandardOver : (E : Type) → [Field E] → ℕ → ℕ → Prop :=
fun E [Field E] n q => Finite E ∧ ∃ F, Finite ↥F ∧ Nat.card ↥F = q ∧ NSDensity.Concrete.nonstandardPair F n
def NSDensity.Concrete.nonstandardPair.{u_1} : {E : Type u_1} → [inst : Field E] → Subfield E → ℕ → Prop :=
fun {E} [Field E] F n => ∃ a, orderOf a = n ∧ NSDensity.Concrete.nonstandardRootCode F n a
def NSDensity.Concrete.nonstandardRootCode.{u_1} : {E : Type u_1} → [inst : Field E] → Subfield E → ℕ → E → Prop :=
fun {E} [Field E] F n a =>
  ∃ σ, NSDensity.Concrete.preservesRelations F (fun i => a ^ ↑i) σ ∧ ¬NSDensity.Concrete.affinePermutation n σ
def NSDensity.Concrete.relationCode.{u_1, u_2} : {E : Type u_1} →
  [inst : Field E] → {I : Type u_2} → [Fintype I] → (F : Subfield E) → (I → E) → Submodule (↥F) (I → ↥F) :=
fun {E} [Field E] {I} [Fintype I] F v =>
  { carrier := {c | ∑ i, ↑(c i) * v i = 0}, add_mem' := ⋯, zero_mem' := ⋯, smul_mem' := ⋯ }
def NSDensity.Concrete.rootFunctionalCode.{u_1} : {E : Type u_1} →
  [inst : Field E] → (F : Subfield E) → (n : ℕ) → E → Submodule (↥F) (Fin n → ↥F) :=
fun {E} [Field E] F n a => NSDensity.Concrete.functionalCode F fun i => a ^ ↑i
def NSDensity.Concrete.irreducibleCyclicCode.{u_1} : {F : Type u_1} →
  [inst : Field F] → {n : ℕ} → Submodule F (Fin n → F) → Prop :=
fun {F} [Field F] {n} C =>
  C ≠ ⊥ ∧ NSDensity.Concrete.cyclicCode C ∧ ∀ D ≤ C, NSDensity.Concrete.cyclicCode D → D = ⊥ ∨ D = C
def NSDensity.Concrete.nondegenerateCode.{u_1} : {F : Type u_1} →
  [inst : Field F] → {n : ℕ} → Submodule F (Fin n → F) → Prop :=
fun {F} [Field F] {n} C => ∀ (i j : Fin n), i ≠ j → ∃ w ∈ C, w i ≠ w j
def NSDensity.NonstandardCyclicCodeWitness : (E : Type) → [Field E] → ℕ → ℕ → Prop :=
fun E [Field E] n q =>
  Finite E ∧
    ∃ F,
      Finite ↥F ∧
        Nat.card ↥F = q ∧
          ∃ a,
            orderOf a = n ∧
              NSDensity.Concrete.irreducibleCyclicCode (NSDensity.Concrete.rootFunctionalCode F n a) ∧
                NSDensity.Concrete.nondegenerateCode (NSDensity.Concrete.rootFunctionalCode F n a) ∧
                  ∃ σ,
                    NSDensity.Concrete.preservesCode F (NSDensity.Concrete.rootFunctionalCode F n a) σ ∧
                      ¬NSDensity.Concrete.standardPermutation q n σ
def NSDensity.Concrete.standardPermutation : ℕ → (n : ℕ) → Equiv.Perm (Fin n) → Prop :=
fun q n σ => ∃ j b, ∀ (i : Fin n), ↑↑(σ i) = ↑q ^ j * ↑↑i + b
@[reducible] def NSDensity.ConcreteFHLXInput : Prop :=
NSDensity.FHLXInput NSDensity.CodeNonstandard
def NSDensity.Concrete.irreducibleCyclicIdeal.{u_1} : {E : Type u_1} →
  [inst : Field E] → (F : Subfield E) → (n : ℕ) → E → Ideal (AdjoinRoot (Polynomial.X ^ n - 1)) :=
fun {E} [Field E] F n a =>
  Ideal.span (Set.singleton ((AdjoinRoot.mk (Polynomial.X ^ n - 1)) ((Polynomial.X ^ n - 1) / minpoly (↥F) a)))
def NSDensity.Concrete.polynomialCyclicCode.{u_1} : {E : Type u_1} →
  [inst : Field E] → (F : Subfield E) → (n : ℕ) → E → Submodule (↥F) (Fin n → ↥F) :=
fun {E} [Field E] F n a =>
  Submodule.comap (NSDensity.Concrete.wordQuotient (↥F) n)
    (Submodule.restrictScalars (↥F) (NSDensity.Concrete.irreducibleCyclicIdeal F n a))
def NSDensity.PaperNonstandard : ℕ → ℕ → Prop :=
fun n q => ∃ E fieldE, NSDensity.PaperNonstandardOver E n q
def NSDensity.PaperNonstandardOver : (E : Type) → [Field E] → ℕ → ℕ → Prop :=
fun E [Field E] n q =>
  Finite E ∧
    ∃ F,
      Finite ↥F ∧
        Nat.card ↥F = q ∧
          ∃ a,
            orderOf a = n ∧
              ∃ σ,
                NSDensity.Concrete.preservesCode F (NSDensity.Concrete.polynomialCyclicCode F n a) σ ∧
                  ¬NSDensity.Concrete.standardPermutation q n σ
@[reducible] def NSDensity.PaperFHLXInput : Prop :=
NSDensity.FHLXInput NSDensity.PaperNonstandard
@NSDensity.density_zero_fixed_characteristic : ∀ {NS : ℕ → ℕ → Prop},
  NSDensity.FHLXInput NS →
    NSDensity.WiertelakMoreeInput → ∀ {p : ℕ}, Nat.Prime p → NSDensity.DensityZero (NSDensity.ExceptionalLengths NS p)
@NSDensity.exceptional_count_le : ∀ {NS : ℕ → ℕ → Prop},
  NSDensity.FHLXInput NS →
    NSDensity.WiertelakMoreeInput →
      ∀ {p : ℕ},
        Nat.Prime p →
          ∀ {ε : ℚ}, 0 < ε → ∃ N, ∀ (X : ℕ), N ≤ X → ↑(NSDensity.count (NSDensity.ExceptionalLengths NS p) X) ≤ ε * ↑X
@NSDensity.density_zero_fixed_alphabet : ∀ {NS : ℕ → ℕ → Prop},
  NSDensity.FHLXInput NS →
    NSDensity.WiertelakMoreeInput →
      ∀ {p r : ℕ}, Nat.Prime p → 0 < r → NSDensity.DensityZero {n | 0 < n ∧ p.Coprime n ∧ NS n (p ^ r)}
@NSDensity.standard_lengths_relative_density_one : ∀ {NS : ℕ → ℕ → Prop},
  NSDensity.FHLXInput NS →
    NSDensity.WiertelakMoreeInput →
      ∀ {p : ℕ}, Nat.Prime p → NSDensity.RelativeDensityOne (NSDensity.StandardLengths NS p) {n | p.Coprime n}
@NSDensity.codeNonstandard_descent : ∀ {p r n : ℕ},
  Nat.Prime p → 0 < r → NSDensity.CodeNonstandard n (p ^ r) → NSDensity.CodeNonstandard n p
@NSDensity.exceptionalLengths_eq_prime : ∀ {p : ℕ},
  Nat.Prime p → NSDensity.ExceptionalLengths NSDensity.CodeNonstandard p = NSDensity.PrimeExceptionalLengths p
@NSDensity.codeNonstandard_iff_cyclicCodeWitness : ∀ {n q : ℕ},
  0 < n → q.Coprime n → (NSDensity.CodeNonstandard n q ↔ ∃ E fieldE, NSDensity.NonstandardCyclicCodeWitness E n q)
NSDensity.concrete_density_zero : NSDensity.ConcreteFHLXInput →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ}, Nat.Prime p → NSDensity.DensityZero (NSDensity.ExceptionalLengths NSDensity.CodeNonstandard p)
NSDensity.concrete_density_limit : NSDensity.ConcreteFHLXInput →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ},
      Nat.Prime p →
        Filter.Tendsto
          (fun X => ↑(NSDensity.realCount (NSDensity.ExceptionalLengths NSDensity.CodeNonstandard p) X) / X)
          Filter.atTop (nhds 0)
NSDensity.concrete_count_isLittleO : NSDensity.ConcreteFHLXInput →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ},
      Nat.Prime p →
        (fun X => ↑(NSDensity.realCount (NSDensity.ExceptionalLengths NSDensity.CodeNonstandard p) X)) =o[Filter.atTop]
          fun X => X
NSDensity.concrete_standard_relative_density_one : NSDensity.ConcreteFHLXInput →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ},
      Nat.Prime p →
        Filter.Tendsto
          (fun X =>
            ↑(NSDensity.realCount (NSDensity.StandardLengths NSDensity.CodeNonstandard p) X) /
              ↑(NSDensity.realCount {n | p.Coprime n} X))
          Filter.atTop (nhds 1)
@NSDensity.paper_exceptionalLengths_eq_prime : ∀ {p : ℕ},
  Nat.Prime p → NSDensity.ExceptionalLengths NSDensity.PaperNonstandard p = NSDensity.PaperPrimeExceptionalLengths p
NSDensity.paper_density_zero : NSDensity.PaperFHLXInput →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ}, Nat.Prime p → NSDensity.DensityZero (NSDensity.ExceptionalLengths NSDensity.PaperNonstandard p)
NSDensity.paper_density_limit : NSDensity.PaperFHLXInput →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ},
      Nat.Prime p →
        Filter.Tendsto
          (fun X => ↑(NSDensity.realCount (NSDensity.ExceptionalLengths NSDensity.PaperNonstandard p) X) / X)
          Filter.atTop (nhds 0)
NSDensity.paper_count_isLittleO : NSDensity.PaperFHLXInput →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ},
      Nat.Prime p →
        (fun X => ↑(NSDensity.realCount (NSDensity.ExceptionalLengths NSDensity.PaperNonstandard p) X)) =o[Filter.atTop]
          fun X => X
NSDensity.paper_standard_relative_density_one : NSDensity.PaperFHLXInput →
  NSDensity.WiertelakMoreeInput →
    ∀ {p : ℕ},
      Nat.Prime p →
        Filter.Tendsto
          (fun X =>
            ↑(NSDensity.realCount (NSDensity.StandardLengths NSDensity.PaperNonstandard p) X) /
              ↑(NSDensity.realCount {n | p.Coprime n} X))
          Filter.atTop (nhds 1)

import Std

/-!
An exhaustive, kernel-checked proof of the prime-two case in an explicit
coordinate model.  This file uses `decide`, never `native_decide`.

Points are the eight vectors in F₂³, encoded as the integers 0,...,7.
Subsets are their eight membership bits, encoded as 0,...,255.
This is a finite-case theorem, not a proof of the conjecture for all primes.
-/

namespace Cylinder.PrimeTwo

set_option maxRecDepth 100000
set_option maxHeartbeats 0

abbrev Point := Fin 8
abbrev Mask := Fin 256
abbrev Bit := Fin 2

def x (p : Point) : Bit := ⟨p.val % 2, Nat.mod_lt _ (by decide)⟩
def y (p : Point) : Bit := ⟨(p.val / 2) % 2, Nat.mod_lt _ (by decide)⟩
def z (p : Point) : Bit := ⟨(p.val / 4) % 2, Nat.mod_lt _ (by decide)⟩

def encode (a b c : Bit) : Point :=
  ⟨a.val + 2 * b.val + 4 * c.val, by omega⟩

theorem encode_coordinates :
    ∀ (a b c : Bit),
      x (encode a b c) = a ∧ y (encode a b c) = b ∧ z (encode a b c) = c := by
  decide

theorem coordinates_encode :
    ∀ p : Point, encode (x p) (y p) (z p) = p := by
  decide

def addBit (a b : Bit) : Bit :=
  ⟨(a.val + b.val) % 2, Nat.mod_lt _ (by decide)⟩

/-- Addition of coordinate vectors in F₂³. -/
def add (p q : Point) : Point :=
  encode (addBit (x p) (x q)) (addBit (y p) (y q)) (addBit (z p) (z q))

theorem add_zero : ∀ p : Point, add p 0 = p := by decide
theorem add_comm : ∀ p q : Point, add p q = add q p := by decide
theorem add_assoc : ∀ p q r : Point, add (add p q) r = add p (add q r) := by decide
theorem add_self : ∀ p : Point, add p p = 0 := by decide
theorem translation_involution : ∀ p d : Point, add (add p d) d = p := by decide
theorem nonzero_translation_no_fixed_point :
    ∀ p d : Point, d ≠ 0 → add p d ≠ p := by decide

def smul (c : Bit) (p : Point) : Point := if c == 0 then 0 else p

theorem independent_directions_iff :
    ∀ u v : Point, (u ≠ 0 ∧ v ≠ 0 ∧ u ≠ v) ↔
      ∀ r s : Bit, add (smul r u) (smul s v) = 0 → r = 0 ∧ s = 0 := by
  decide

def mem (s : Mask) (p : Point) : Bool :=
  (s.val / 2 ^ p.val) % 2 == 1

def cardinality (s : Mask) : Nat :=
  (List.finRange 8).foldl (fun count p => count + if mem s p then 1 else 0) 0

/-- The affine plane with equation nₓx+nᵧy+n_z z=b, modulo two. -/
def onPlane (n : Point) (b : Bit) (p : Point) : Bool :=
  ((x n).val * (x p).val + (y n).val * (y p).val + (z n).val * (z p).val) % 2 == b.val

def intersectionSize (s : Mask) (n : Point) (b : Bit) : Nat :=
  (List.finRange 8).foldl
    (fun count p => count + if mem s p && onPlane n b p then 1 else 0) 0

def planeSize (n : Point) (b : Bit) : Nat :=
  (List.finRange 8).foldl (fun count p => count + if onPlane n b p then 1 else 0) 0

/-- Every nonzero normal gives a four-point affine plane. -/
theorem nonzero_plane_size :
    ∀ n : Point, n ≠ 0 → ∀ b : Bit, planeSize n b = 4 := by decide

/-- Distinct nonzero normal/offset pairs describe distinct affine planes. -/
theorem affine_planes_distinct :
    ∀ n₁ n₂ : Point, ∀ b₁ b₂ : Bit, n₁ ≠ 0 → n₂ ≠ 0 →
      (∀ p : Point, onPlane n₁ b₁ p = onPlane n₂ b₂ p) → n₁ = n₂ ∧ b₁ = b₂ := by
  decide

/-- The four affine combinations of two independent binary directions. -/
def onAffineSpan (a u v p : Point) : Bool :=
  p == a || p == add a u || p == add a v || p == add (add a u) v

/-- Every affine plane generated by two independent directions is in the list. -/
theorem affine_spans_are_planes :
    ∀ a u v : Point, u ≠ 0 → v ≠ 0 → u ≠ v →
      ∃ n : Point, ∃ b : Bit, n ≠ 0 ∧
        ∀ p : Point, onAffineSpan a u v p = onPlane n b p := by
  decide

/-- Conversely, every nonzero normal equation is an affine two-dimensional span. -/
theorem planes_are_affine_spans :
    ∀ n : Point, n ≠ 0 → ∀ b : Bit,
      ∃ a u v : Point, u ≠ 0 ∧ v ≠ 0 ∧ u ≠ v ∧
        ∀ p : Point, onPlane n b p = onAffineSpan a u v p := by
  decide

def allPlanesEven (s : Mask) : Bool :=
  (List.finRange 8).all fun n =>
    if n == 0 then true else
      (List.finRange 2).all fun b => intersectionSize s n b % 2 == 0

/-- In characteristic two, a line is the pair {a,a+d}, where d is nonzero. -/
def onLine (a d p : Point) : Bool := p == a || p == add a d

def lineSize (a d : Point) : Nat :=
  (List.finRange 8).foldl (fun count p => count + if onLine a d p then 1 else 0) 0

theorem nonzero_line_size :
    ∀ a d : Point, d ≠ 0 → lineSize a d = 2 := by decide

/-- Exact equality of a subset with two disjoint lines in the same direction. -/
def isTwoLines (s : Mask) (d a b : Point) : Bool :=
  (d != 0) && (b != a) && (b != add a d) &&
    (List.finRange 8).all fun p => mem s p == (onLine a d p || onLine b d p)

def isCylinder (s : Mask) : Bool :=
  (List.finRange 8).any fun d =>
    (List.finRange 8).any fun a =>
      (List.finRange 8).any fun b => isTwoLines s d a b

/-- The cylinder conjecture for p=2, in the explicit finite coordinate model. -/
theorem cylinder_conjecture_prime_two :
    ∀ s : Mask, cardinality s = 4 → allPlanesEven s = true → isCylinder s = true := by
  decide

/-- The Boolean cylinder predicate has precisely its stated existential meaning. -/
theorem cylinder_exhibits_two_lines :
    ∀ s : Mask, isCylinder s = true →
      ∃ d a b : Point, d ≠ 0 ∧ b ≠ a ∧ b ≠ add a d ∧
        ∀ p : Point, mem s p = (onLine a d p || onLine b d p) := by
  decide

/-- The Boolean plane condition is exactly even intersection for every plane. -/
theorem planes_even_iff :
    ∀ s : Mask, allPlanesEven s = true ↔
      ∀ n : Point, n ≠ 0 → ∀ b : Bit, intersectionSize s n b % 2 = 0 := by
  decide

def encodeBits (b0 b1 b2 b3 b4 b5 b6 b7 : Bool) : Mask :=
  ⟨(if b0 then 1 else 0) + (if b1 then 2 else 0) +
    (if b2 then 4 else 0) + (if b3 then 8 else 0) +
    (if b4 then 16 else 0) + (if b5 then 32 else 0) +
    (if b6 then 64 else 0) + (if b7 then 128 else 0), by
    cases b0 <;> cases b1 <;> cases b2 <;> cases b3 <;>
      cases b4 <;> cases b5 <;> cases b6 <;> cases b7 <;> decide⟩

def selectBit (b0 b1 b2 b3 b4 b5 b6 b7 : Bool) (p : Point) : Bool :=
  if p == 0 then b0 else if p == 1 then b1 else if p == 2 then b2 else
    if p == 3 then b3 else if p == 4 then b4 else if p == 5 then b5 else
      if p == 6 then b6 else b7

theorem mem_encodeBits :
    ∀ (b0 b1 b2 b3 b4 b5 b6 b7 : Bool) (p : Point),
      mem (encodeBits b0 b1 b2 b3 b4 b5 b6 b7) p =
        selectBit b0 b1 b2 b3 b4 b5 b6 b7 p := by
  decide

/-- Encoding of an arbitrary Boolean subset of F₂³. -/
def encodeSubset (s : Point → Bool) : Mask :=
  encodeBits (s 0) (s 1) (s 2) (s 3) (s 4) (s 5) (s 6) (s 7)

theorem point_cases :
    ∀ p : Point, p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 ∨ p = 5 ∨ p = 6 ∨ p = 7 := by
  decide

theorem mem_encodeSubset (s : Point → Bool) (p : Point) :
    mem (encodeSubset s) p = s p := by
  have h := mem_encodeBits (s 0) (s 1) (s 2) (s 3) (s 4) (s 5) (s 6) (s 7) p
  have hp := point_cases p
  rcases hp with hp | hp | hp | hp | hp | hp | hp | hp
  all_goals subst p; simpa [encodeSubset, selectBit] using h

def subsetCardinality (s : Point → Bool) : Nat :=
  (List.finRange 8).foldl (fun count p => count + if s p then 1 else 0) 0

def subsetIntersectionSize (s : Point → Bool) (n : Point) (b : Bit) : Nat :=
  (List.finRange 8).foldl
    (fun count p => count + if s p && onPlane n b p then 1 else 0) 0

theorem subset_cardinality_bridge (s : Point → Bool) :
    cardinality (encodeSubset s) = subsetCardinality s := by
  simp only [cardinality, subsetCardinality, mem_encodeSubset]

theorem subset_intersection_bridge (s : Point → Bool) (n : Point) (b : Bit) :
    intersectionSize (encodeSubset s) n b = subsetIntersectionSize s n b := by
  simp only [intersectionSize, subsetIntersectionSize, mem_encodeSubset]

/-- The same conclusion for any Boolean subset, independently of its bit mask. -/
theorem cylinder_conjecture_predicate_prime_two
    (s : Point → Bool)
    (hcard : subsetCardinality s = 4)
    (hplanes : ∀ n : Point, n ≠ 0 → ∀ b : Bit, subsetIntersectionSize s n b % 2 = 0) :
    ∃ d a b : Point, d ≠ 0 ∧ b ≠ a ∧ b ≠ add a d ∧
      ∀ p : Point, s p = (onLine a d p || onLine b d p) := by
  have hcard' : cardinality (encodeSubset s) = 4 := by
    simpa only [subset_cardinality_bridge] using hcard
  have hplanes' : allPlanesEven (encodeSubset s) = true := by
    apply (planes_even_iff (encodeSubset s)).mpr
    intro n hn b
    simpa only [subset_intersection_bridge] using hplanes n hn b
  have hcylinder := cylinder_conjecture_prime_two (encodeSubset s) hcard' hplanes'
  rcases cylinder_exhibits_two_lines (encodeSubset s) hcylinder with
    ⟨d, a, b, hd, hab, hadd, hmem⟩
  refine ⟨d, a, b, hd, hab, hadd, ?_⟩
  intro p
  simpa only [mem_encodeSubset] using hmem p

#print axioms cylinder_conjecture_prime_two
#print axioms cylinder_conjecture_predicate_prime_two

end Cylinder.PrimeTwo

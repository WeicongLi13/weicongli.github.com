module

public import Cylinder.RedeiExponential
public import Cylinder.RedeiDivisibility
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! Initial moments of an exact additive factorization satisfy the p-th
power ideal relation. We use a univariate polynomial to keep track of total degree. -/
@[expose] public section
noncomputable section
namespace Cylinder.Redei
open scoped Classical BigOperators Polynomial
open Geometry

private theorem coeff_first_product {R : Type*} [CommRing R] (P Q : R[X]) (r d : ℕ)
    (hP : ∀ i < r, P.coeff i = 0) (hQ : ∀ i < d, Q.coeff i = 0) :
    (P*Q).coeff (r+d) = P.coeff r * Q.coeff d := by
  rw [Polynomial.coeff_mul]
  apply Finset.sum_eq_single (r,d)
  · rintro ⟨i,j⟩ hij hn
    have he : i+j=r+d := Finset.mem_antidiagonal.mp hij
    by_cases hi : i<r
    · simp [hP i hi]
    · have hj : j<d := by
        by_contra! h
        exact hn (Prod.ext (by dsimp; omega) (by dsimp; omega))
      simp [hQ j hj]
  · simp

variable (p : ℕ) [Fact p.Prime]
private abbrev P3 := MvPolynomial (Fin 3) (ZMod p)

private theorem weightSum_coeff {R : Type*} [CommRing R] [Algebra (ZMod p) R]
    (q : P3 p →ₐ[ZMod p] R) (S : Finset (Point p)) (k : ℕ) (hk : k < p) :
    (∑ x ∈ S, expWeight p (fun i => q (MvPolynomial.X i)) x).coeff k =
      invFac p R k * q (moment p S k) := by
  have hC (x : ZMod p) : q (MvPolynomial.C x) = algebraMap (ZMod p) R x := q.commutes x
  simp only [Polynomial.finsetSum_coeff, expWeight_coeff p _ _ _ hk, moment,
    PowerEvaluationRelation.linearForm, map_sum, map_pow, map_mul, hC, Finset.mul_sum]

/-- The product of the two initial moments lies in the ideal generated by
the coordinate p-th powers. This does not presume any divisibility of B. -/
theorem first_moments_mem_coordinate_powers (A B : Finset (Point p))
    (hab : AddSubgroup.IsComplement (A : Set (Point p)) B)
    (r d : ℕ) (hr : r<p) (hd : d<p)
    (ha : ∀ k<r, moment p A k = 0) (hb : ∀ k<d, moment p B k = 0) :
    moment p A r * moment p B d ∈ Ideal.span
      (Set.range (fun i : Fin 3 => (MvPolynomial.X i : MvPolynomial (Fin 3) (ZMod p))^p)) := by
  let I : Ideal (P3 p) := Ideal.span (Set.range fun i : Fin 3 => (MvPolynomial.X i : P3 p)^p)
  let R := (P3 p) ⧸ I
  let q : P3 p →ₐ[ZMod p] R := Ideal.Quotient.mkₐ (ZMod p) I
  let z : Fin 3 → R := fun i => q (MvPolynomial.X i)
  have hz (i : Fin 3) : z i ^ p = 0 := by
    change (q (MvPolynomial.X i)) ^ p = 0
    rw [← map_pow]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i,rfl⟩)
  let T (S : Finset (Point p)) := ∑ x ∈ S, expWeight p z x
  have hcoeff (S : Finset (Point p)) (k : ℕ) (hk : k<p) :
      (T S).coeff k = invFac p R k * q (moment p S k) :=
    weightSum_coeff p q S k hk
  obtain ⟨c,h⟩ := tiling_exp_product p z hz A B hab
  change T A * T B = _ at h
  have hsmall : r+d < 3*(p-1) := by have hp := (Fact.out : p.Prime).two_le; omega
  have hdeg := congrArg (fun P : R[X] => P.coeff (r+d)) h
  have h0 := coeff_first_product (T A) (T B) r d
    (fun k hk => by rw [hcoeff A k (hk.trans hr), ha k hk, map_zero, mul_zero])
    (fun k hk => by rw [hcoeff B k (hk.trans hd), hb k hk, map_zero, mul_zero])
  change (T A * T B).coeff (r+d) = _ at hdeg
  rw [h0, hcoeff A r hr, hcoeff B d hd, Polynomial.coeff_monomial,
    ite_eq_right (Nat.ne_of_gt hsmall)] at hdeg
  have hunit (k : ℕ) (hk : k<p) : IsUnit (invFac p R k) := by
    have hf : (k.factorial : ZMod p) ≠ 0 := by
      rw [Ne, ZMod.natCast_eq_zero_iff, (Fact.out : p.Prime).dvd_factorial]
      omega
    exact (isUnit_iff_ne_zero.mpr (inv_ne_zero hf)).map (algebraMap (ZMod p) R)
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q (moment p A r * moment p B d) = 0
  rw [map_mul]
  apply ((hunit r hr).mul (hunit d hd)).mul_right_eq_zero.mp
  linear_combination hdeg

end Cylinder.Redei
end

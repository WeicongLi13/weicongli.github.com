import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-! Decomposing a homogeneous member of the ideal generated by pure
powers, retaining the degree of each multiplier. -/

noncomputable section
namespace Cylinder.RedeiPowers

open MvPolynomial
open scoped BigOperators

variable {σ K : Type*} [CommSemiring K]

local instance : GradedAlgebra (homogeneousSubmodule σ K) := MvPolynomial.gradedAlgebra

private theorem component_mul_homogeneous {P : MvPolynomial σ K} {p : ℕ}
    (hP : P.IsHomogeneous p) (Q : MvPolynomial σ K) (n : ℕ) :
    homogeneousComponent n (P * Q) =
      if p ≤ n then P * homogeneousComponent (n-p) Q else 0 := by
  have h := DirectSum.coe_decompose_mul_of_left_mem (homogeneousSubmodule σ K) n hP (b := Q)
  have hc (R : MvPolynomial σ K) (d : ℕ) :
      (DirectSum.decompose (homogeneousSubmodule σ K) R d : MvPolynomial σ K) =
        homogeneousComponent d R := MvPolynomial.decomposition.decompose'_apply R d
  rw [hc] at h
  by_cases hn : p ≤ n
  · rw [ite_eq_left hn,hc] at h
    simpa only [hn,ite_true] using h
  · simpa only [hn,ite_false] using h

/-- A nonzero homogeneous polynomial in the pure-power ideal has degree
at least p; in degree n, its multipliers can all be chosen in degree n−p. -/
theorem homogeneous_decomposition [Fintype σ] (p n : ℕ) (T : MvPolynomial σ K)
    (hT : T.IsHomogeneous n) (hne : T ≠ 0)
    (hmem : T ∈ Ideal.span (Set.range (fun i : σ => (X i : MvPolynomial σ K)^p))) :
    p ≤ n ∧ ∃ U : σ → MvPolynomial σ K, (∀ i, (U i).IsHomogeneous (n-p)) ∧
      T = ∑ i, (X i)^p * U i := by
  classical
  obtain ⟨C,hC⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  have hd := congrArg (homogeneousComponent n : MvPolynomial σ K →ₗ[K] MvPolynomial σ K) hC
  rw [map_sum,homogeneousComponent_eq_self hT] at hd
  simp_rw [mul_comm (C _), component_mul_homogeneous (isHomogeneous_X_pow _ _)] at hd
  have hpn : p ≤ n := by
    by_contra hn
    simp [hn] at hd
    exact hne hd.symm
  exact ⟨hpn,fun i => homogeneousComponent (n-p) (C i),
    fun i => homogeneousComponent_isHomogeneous _ _, by simpa [hpn] using hd.symm⟩

end Cylinder.RedeiPowers

module

public import Cylinder.IntersectionResolution

/-!
# The actual ideal presentation and its homogeneous resolution

The last map is onto the ideal generated by the real cofactors. The
first map has the proved kernel basis. Its homogeneous generators have
total shifted degree `s`, and the degree-piece syzygy description is
proved by homogeneous division; below degree `s` the kernel is zero.
-/

@[expose] public section

noncomputable section

namespace Cylinder.IntersectionGradedResolution

open Module MvPolynomial Cylinder.IntersectionResolution
open scoped BigOperators Classical

variable {R I : Type*} [CommRing R] [IsDomain R] [DecompositionMonoid R] [Fintype I]

def componentIdeal (F : I → R) : Ideal R := LinearMap.range (generationMap F)

theorem generationMap_single (F : I → R) (i : I) :
    generationMap F (Pi.single i 1) = cofactor F i := by
  simp [generationMap, Pi.single_apply]

theorem componentIdeal_eq_span (F : I → R) :
    componentIdeal F = Ideal.span (Set.range (cofactor F)) := by
  apply le_antisymm
  · rintro b ⟨A, rfl⟩
    change (∑ i, A i * cofactor F i) ∈ Ideal.span (Set.range (cofactor F))
    apply Ideal.sum_mem
    intro i _
    exact Ideal.mul_mem_left _ _ Ideal.mem_span_range_self
  · apply Ideal.span_le.mpr
    rintro b ⟨i, rfl⟩
    exact ⟨Pi.single i 1, generationMap_single F i⟩

def presentationMap (F : I → R) : (I → R) →ₗ[R] componentIdeal F where
  toFun A := ⟨generationMap F A, ⟨A, rfl⟩⟩
  map_add' A B := by apply Subtype.ext; exact map_add (generationMap F) A B
  map_smul' a A := by apply Subtype.ext; exact map_smul (generationMap F) a A

theorem presentationMap_surjective (F : I → R) : Function.Surjective (presentationMap F) := by
  rintro ⟨b, hb⟩
  obtain ⟨A, hA⟩ := hb
  refine ⟨A, ?_⟩
  exact Subtype.ext hA

theorem presentationMap_kernel (F : I → R) :
    LinearMap.ker (presentationMap F) = LinearMap.ker (generationMap F) := by
  ext A
  simp only [LinearMap.mem_ker]
  constructor
  · intro h
    exact congrArg Subtype.val h
  · intro h
    exact Subtype.ext h

theorem actual_resolution {n : ℕ} (F : Fin (n + 1) → R) (hF0 : ∀ i, F i ≠ 0)
    (hF : Pairwise (fun i j => IsRelPrime (F i) (F j))) :
    Function.Injective (syzygyMap F hF0 hF) ∧
      LinearMap.range (syzygyMap F hF0 hF) = LinearMap.ker (presentationMap F) ∧
      Function.Surjective (presentationMap F) := by
  refine ⟨syzygyMap_injective F hF0 hF, ?_, presentationMap_surjective F⟩
  rw [presentationMap_kernel, syzygyMap_range_eq_kernel]

theorem syzygyMap_apply_zero {n : ℕ} (F : Fin (n + 1) → R) (hF0 : ∀ i, F i ≠ 0)
    (hF : Pairwise (fun i j => IsRelPrime (F i) (F j))) (T : Fin n → R) :
    syzygyMap F hF0 hF T 0 = F 0 * (-(∑ i, T i)) := rfl

theorem syzygyMap_apply_succ {n : ℕ} (F : Fin (n + 1) → R) (hF0 : ∀ i, F i ≠ 0)
    (hF : Pairwise (fun i j => IsRelPrime (F i) (F j))) (T : Fin n → R) (i : Fin n) :
    syzygyMap F hF0 hF T i.succ = F i.succ * T i := rfl

section PlaneForms

variable {K : Type*} [Field K]

abbrev PlaneRing := MvPolynomial (Fin 3) K

theorem totalProduct_homogeneous (F : I → PlaneRing (K := K)) (e : I → ℕ)
    (hF : ∀ i, (F i).IsHomogeneous (e i)) :
    (totalProduct F).IsHomogeneous (∑ i, e i) :=
  IsHomogeneous.prod Finset.univ F e (fun i _ => hF i)

theorem cofactor_homogeneous (F : I → PlaneRing (K := K)) (e : I → ℕ)
    (hF : ∀ i, (F i).IsHomogeneous (e i)) (i : I) :
    (cofactor F i).IsHomogeneous ((∑ j, e j) - e i) := by
  have h := IsHomogeneous.prod (Finset.univ.erase i) F e (fun j _ => hF j)
  have hsum := Finset.sum_erase_add Finset.univ e (Finset.mem_univ i)
  have heq : (∑ j ∈ Finset.univ.erase i, e j) = (∑ j, e j) - e i := by omega
  unfold cofactor
  rw [← heq]
  exact h

theorem cofactor_totalDegree (F : I → PlaneRing (K := K)) (e : I → ℕ)
    (hF0 : ∀ i, F i ≠ 0) (hF : ∀ i, (F i).IsHomogeneous (e i)) (i : I) :
    (cofactor F i).totalDegree = (∑ j, e j) - e i :=
  (cofactor_homogeneous F e hF i).totalDegree (cofactor_ne_zero F hF0 i)

/-- The `n` actual free syzygy generators each have total shifted degree `s`. -/
theorem syzygy_generators_homogeneous {n : ℕ} (F : Fin (n + 1) → PlaneRing (K := K))
    (e : Fin (n + 1) → ℕ) (hF0 : ∀ i, F i ≠ 0)
    (hF : Pairwise (fun i j => IsRelPrime (F i) (F j)))
    (hhom : ∀ i, (F i).IsHomogeneous (e i)) (j : Fin n) (i : Fin (n + 1)) :
    (syzygyMap F hF0 hF (Pi.single j 1) i).IsHomogeneous (e i) := by
  cases i using Fin.cases with
  | zero =>
    rw [syzygyMap_apply_zero]
    simpa [Pi.single_apply] using (hhom 0).neg
  | succ i =>
    rw [syzygyMap_apply_succ]
    by_cases hij : j = i
    · simpa [Pi.single_apply, hij] using hhom i.succ
    · simp [Pi.single_apply, hij, isHomogeneous_zero]

/-- Exactness on every nonnegative shifted degree piece above `s`. -/
theorem homogeneous_syzygy_iff (F A : I → PlaneRing (K := K)) (e : I → ℕ)
    (hF0 : ∀ i, F i ≠ 0) (hF : Pairwise (fun i j => IsRelPrime (F i) (F j)))
    (hhom : ∀ i, (F i).IsHomogeneous (e i)) (d : ℕ)
    (hA : ∀ i, (A i).IsHomogeneous (e i + d)) :
    generationMap F A = 0 ↔
      ∃ C : I → PlaneRing (K := K),
        (∀ i, (C i).IsHomogeneous d) ∧ (∀ i, A i = F i * C i) ∧ ∑ i, C i = 0 := by
  constructor
  · intro hrel
    obtain ⟨C, hC, hsum⟩ := (syzygy_iff F A hF0 hF).mp hrel
    refine ⟨C, ?_, hC, hsum⟩
    intro i
    exact HomogeneousDivision.quotient_isHomogeneous (F i) (A i) (C i) (e i) d
      (hF0 i) (hhom i) (hA i) (hC i).symm
  · rintro ⟨C, hChom, hC, hsum⟩
    exact (syzygy_iff F A hF0 hF).mpr ⟨C, hC, hsum⟩

/-- Below total degree `s` the actual shifted-degree kernel is zero. -/
theorem syzygy_zero_below_total_degree (F A : I → PlaneRing (K := K)) (e : I → ℕ)
    (hF0 : ∀ i, F i ≠ 0) (hF : Pairwise (fun i j => IsRelPrime (F i) (F j)))
    (hhom : ∀ i, (F i).IsHomogeneous (e i)) (v : ℕ) (hv : v < ∑ i, e i)
    (hA : ∀ i, if v < (∑ j, e j) - e i then A i = 0
      else (A i).IsHomogeneous (v - ((∑ j, e j) - e i)))
    (hrel : generationMap F A = 0) : A = 0 := by
  funext i
  change A i = 0
  by_cases hbelow : v < (∑ j, e j) - e i
  · simpa only [hbelow, ite_true] using hA i
  · have hAi : (A i).IsHomogeneous (v - ((∑ j, e j) - e i)) := by
      simpa only [hbelow, ite_false] using hA i
    by_contra hAi0
    have hdvd := coefficient_dvd_of_relation F A hF hrel i
    have hle := totalDegree_le_of_dvd_of_isDomain hdvd hAi0
    rw [(hhom i).totalDegree (hF0 i), hAi.totalDegree hAi0] at hle
    have hei : e i ≤ ∑ j, e j := Finset.single_le_sum (fun _ _ => Nat.zero_le _)
      (Finset.mem_univ i)
    omega

end PlaneForms

#print axioms componentIdeal_eq_span
#print axioms actual_resolution
#print axioms homogeneous_syzygy_iff
#print axioms syzygy_zero_below_total_degree

end Cylinder.IntersectionGradedResolution

